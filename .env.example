# =============================================================================
# Landbruget.dk — Consolidated Environment Variables
# Copy to .env and fill in your credentials
# =============================================================================

# --- Frontend (Supabase) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_KEY=

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-project-id
LANDBRUGSDATA_UUID_NAMESPACE=
STORAGE_BUCKET=landbruget-data
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json  # Only needed for drive_data_pipeline

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=landbruget-data

# --- Cloudflare API ---
CLOUDFLARE_API_TOKEN=

# --- FVM API Credentials ---
FVM_USERNAME=
FVM_PASSWORD=
FVM_CLIENT_ID=

# --- VetStat Certificate ---
VETSTAT_CERTIFICATE=
VETSTAT_CERTIFICATE_PASSWORD=
VETSTAT_CERTIFICATE_PATH=/path/to/vetstat.p12

# --- Datafordeler SFTP ---
DATAFORDELER_SFTP_HOST=ftp2.datafordeler.dk
DATAFORDELER_SFTP_USERNAME=
SSH_KEY_BRUGERDATAFORDELEREN=

# --- Datafordeler GraphQL API ---
DATAFORDELER_GRAPHQL_API_KEY=

# --- Google Drive (drive_data_pipeline only) ---
GOOGLE_DRIVE_FOLDER_ID=
