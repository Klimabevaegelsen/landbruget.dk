# Runtime note
# The live frontend-pesticide app discovers H3 and BNBO data from PMTiles.
# No Supabase browser credentials are required.

# Development settings
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Optional: Analytics and monitoring
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here

# Optional: Map configuration
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=55.7
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LON=12.0
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=7

# PMTiles / R2 endpoints
NEXT_PUBLIC_PMTILES_BASE_URL=https://api.landbruget.dk
NEXT_PUBLIC_PMTILES_MANIFEST_PATH=/pmtiles/pmtiles-manifest.json

# Optional: Data limits for performance
NEXT_PUBLIC_MAX_H3_HEXAGONS=10000
NEXT_PUBLIC_MAX_BNBO_POLYGONS=1000
NEXT_PUBLIC_MAX_BBR_BUILDINGS=5000
