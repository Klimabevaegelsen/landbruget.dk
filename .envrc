# Automatically activate the uv-managed virtual environment when entering this directory
# Install direnv: brew install direnv
# Then add to your shell: eval "$(direnv hook zsh)"

# Load all environment variables from root .env
dotenv

# Create .venv if missing (first time setup)
if [ ! -d ".venv" ] && command -v uv &> /dev/null; then
    uv sync --all-packages
fi

source .venv/bin/activate

# Set PYTHONPATH so imports resolve across the workspace
export PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}${PWD}"
export PYTHONDONTWRITEBYTECODE=1

# GCP project for Secret Manager bootstrap (R2 credentials, DB creds, etc.)
export GCP_PROJECT="${GCP_PROJECT:-landbrugsdata-1}"
