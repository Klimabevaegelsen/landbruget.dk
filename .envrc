# Automatically activate the uv-managed virtual environment when entering this directory
# Install direnv: brew install direnv
# Then add to your shell: eval "$(direnv hook zsh)"

# Load all environment variables from root .env. Use shell sourcing instead of
# direnv's dotenv parser because this repo can contain quoted multiline keys.
source_env_if_exists .env

# Create .venv if missing (first time setup)
if [ ! -d ".venv" ] && command -v uv &> /dev/null; then
    uv sync --all-packages
fi

source .venv/bin/activate

# Set PYTHONPATH so imports resolve across the workspace
export PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}${PWD}"
export PYTHONDONTWRITEBYTECODE=1

# GCP project/account for this workspace.
export GCP_PROJECT="landbrugsdata-1"
export GOOGLE_CLOUD_PROJECT="landbrugsdata-1"
export CLOUDSDK_CORE_PROJECT="landbrugsdata-1"
export CLOUDSDK_CORE_ACCOUNT="danskcollignon@gmail.com"
