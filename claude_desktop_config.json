{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest", "--features=database,docs"]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PAT_HERE"
      }
    },
    "gcp": {
      "command": "npx",
      "args": ["-y", "gcp-mcp"]
    },
    "cloudflare-observability": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://observability.mcp.cloudflare.com/mcp"]
    },
    "cloudflare-workers": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://bindings.mcp.cloudflare.com/mcp"]
    },
    "cloudflare-radar": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://radar.mcp.cloudflare.com/mcp"]
    },
    "cloudflare-ai-gateway": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://ai-gateway.mcp.cloudflare.com/mcp"]
    },
    "cloudflare-dns-analytics": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://dns-analytics.mcp.cloudflare.com/mcp"]
    }
  }
}
