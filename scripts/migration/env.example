# Parquet to Supabase Migration Environment Configuration
# Copy this file to .env and update with your actual values

# =================================================================
# SUPABASE CONFIGURATION
# =================================================================

# Local Development (Supabase CLI)
SUPABASE_LOCAL_HOST=127.0.0.1
SUPABASE_LOCAL_PORT=54322
SUPABASE_LOCAL_PASSWORD=postgres

# Staging Environment
SUPABASE_STAGING_HOST=your-staging-project.supabase.co
SUPABASE_STAGING_PASSWORD=your_staging_password
SUPABASE_STAGING_PROJECT_REF=your_staging_project_ref

# Production Environment
SUPABASE_PROD_HOST=your-production-project.supabase.co
SUPABASE_PROD_PASSWORD=your_production_password
SUPABASE_PROD_PROJECT_REF=your_production_project_ref

# =================================================================
# GOOGLE CLOUD STORAGE CONFIGURATION
# =================================================================

# GCS Bucket for parquet data
GCS_BUCKET=gs://landbrugsdata-raw-data

# Google Cloud Service Account (for authentication)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Project ID
GCP_PROJECT_ID=your-gcp-project-id

# =================================================================
# MIGRATION CONFIGURATION
# =================================================================

# Performance Settings
DEFAULT_BATCH_SIZE=10000
MAX_WORKERS=4
CONNECTION_POOL_SIZE=8

# Validation Settings
ENABLE_DATA_VALIDATION=true
SKIP_EXISTING_RECORDS=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/migration/

# =================================================================
# MONITORING & ALERTS
# =================================================================

# Performance Thresholds
CPU_ALERT_THRESHOLD=90.0
MEMORY_ALERT_THRESHOLD=85.0
ERROR_RATE_ALERT_THRESHOLD=0.05
MIN_RECORDS_PER_SECOND=100.0

# =================================================================
# OPTIONAL: EXTERNAL SERVICES
# =================================================================

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
NOTIFICATION_EMAIL=admin@yourcompany.com


