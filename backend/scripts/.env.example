# GCS to R2 Sync Configuration

# Source GCS bucket
STORAGE_BUCKET=landbruget-data
# GCS_BUCKET=landbruget-data  # Legacy fallback

# Destination R2 bucket
R2_BUCKET=

# Cloudflare R2 credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: GCS authentication (if not using application default credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ====================================
# Schema Documentation Generator
# ====================================

# GCS bucket for schema documentation (defaults to GCS_BUCKET if not set)
# GCS_BUCKET=landbruget-data

# GCS HMAC credentials (preferred for better performance)
GCS_ACCESS_KEY_ID=
GCS_SECRET_ACCESS_KEY=

# Alternative: Service account authentication
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ====================================
# Schema Upload to Gemini
# ====================================

# Google Gemini API key (required)
GOOGLE_API_KEY=

# Gemini File Search Store ID (optional - created via --create-store)
GEMINI_FILE_SEARCH_STORE_ID=
