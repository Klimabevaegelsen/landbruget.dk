# H3 PFAS Exposure Pipeline Configuration Example
# Copy this to .env and modify as needed

# GCS Configuration
GCS_BUCKET=landbrugsdata-raw-data

# H3 Configuration
H3_RESOLUTION=10
CHUNK_SIZE=25000

# Processing Configuration
MEMORY_LIMIT=12GB
THREAD_COUNT=4

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_PROGRESS_TRACKING=true
LOG_CHUNK_DETAILS=true
LOG_STAGE_TIMINGS=true

# Output Configuration (optional)
OUTPUT_DIR=data/gold/h3_pfas_exposure

# Development/Debug (optional)
# LOG_LEVEL=DEBUG
# MEMORY_LIMIT=8GB
# CHUNK_SIZE=10000 