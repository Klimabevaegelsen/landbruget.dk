{
  "metadata": {
    "description": "Reference implementation constants",
    "extracted_date": "2026-01-11",
    "notes": "Python implementation uses AR6 GWP"
  },
  "gwp_constants": {
    "AR4": {
      "description": "IPCC Fourth Assessment Report (2007)",
      "N2O": 298,
      "CH4": 25
    },
    "AR5": {
      "description": "IPCC Fifth Assessment Report (2014)",
      "N2O": 265,
      "CH4": 28
    },
    "AR6": {
      "description": "IPCC Sixth Assessment Report (2021) - Used by Python implementation",
      "N2O": 273,
      "CH4_biogenic": 27,
      "CH4_fossil": 30
    }
  },
  "emission_factors": {
    "n2o_direct_application": {
      "value": 0.01,
      "unit": "kg N2O-N per kg N applied",
      "reference": "IPCC 2006, Table 11.1",
      "parameter": "EFN2O"
    },
    "n2o_indirect_leaching": {
      "value": 0.0075,
      "unit": "kg N2O-N per kg N leached",
      "reference": "IPCC 2006, Table 11.3",
      "formula": "0.0075 * (44/28)"
    },
    "n2o_crop_residue": {
      "value": 0.01,
      "unit": "kg N2O-N per kg N in residue",
      "reference": "IPCC 2006",
      "parameter": "EFN2O"
    },
    "mcf_slurry": {
      "value": 12.4,
      "unit": "%",
      "reference": "Nielsen et al. 2020",
      "parameter": "MCF"
    },
    "mcf_deep_litter": {
      "value": 17.0,
      "unit": "%",
      "reference": "IPCC 2006",
      "parameter": "MCF"
    }
  },
  "molecular_weights": {
    "N2": 28,
    "N2O": 44,
    "C": 12,
    "CO2": 44,
    "CaCO3": 100.09,
    "C_in_CaCO3": 12.01
  },
  "carbon_balance": {
    "carbon_fraction_dm": 0.45,
    "danish_avg_c_input_kg_ha": 4093.0,
    "humification_coefficient": 0.097,
    "parameter": "CFAvgCropKgC"
  },
  "formula_mappings": {
    "nitrate_leaching": {
      "csharp_class": "FormulaNitrateLeaching",
      "python_module": "formulas.marker.nitratudvaskning",
      "csharp_formula": "N2OTotal += KgNPerHa * 0.0075 * 44 / 28 * cropArea; CO2e = N2OTotal * CFN2OToCO2e"
    },
    "crop_residue": {
      "csharp_class": "FormulaCropResidue",
      "python_module": "formulas.marker.afgroederester",
      "csharp_formula": "N2OTotal = kgNTotal * EFN2O * 44 / 28; CO2eValue = N2OTotal * CFN2OToCO2e"
    },
    "dairy_digestion": {
      "csharp_class": "FormulaDigestionDairyCows",
      "python_module": "formulas.kvaeg.enterisk_metan",
      "csharp_formula_heavy": "(1.230 * feedIntake - 0.145 * fattyAcids + 0.012 * ndf) / 55.65 * 335 + 0.304 * 30",
      "csharp_formula_jersey": "(1.230 * feedIntake - 0.145 * fattyAcids + 0.012 * ndf) / 55.65 * 335 + 0.207 * 30"
    },
    "liming": {
      "csharp_class": "FormulaLimeApplied",
      "python_module": "formulas.marker.kalkning",
      "csharp_formula": "((TotalKgLimePrYear / 100.09 * 12.01) * 44 / 12)"
    }
  }
}
