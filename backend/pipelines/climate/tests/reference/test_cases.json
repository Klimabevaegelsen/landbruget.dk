{
  "metadata": {
    "description": "Test cases with known inputs/outputs for compliance verification",
    "note": "Expected outputs calculated using reference formula logic with both AR4 and AR6 GWP values"
  },
  "nitrate_leaching": [
    {
      "test_id": "NL001",
      "description": "Spring barley (Vårbyg, code 1) on 100 ha",
      "inputs": {
        "typetal_kg_n_per_ha": 63.0,
        "area_ha": 100.0
      },
      "expected_outputs": {
        "n2o_kg": 74.25,
        "co2e_kg_gwp_ar4": 22126.5,
        "co2e_kg_gwp_ar6": 20270.25
      },
      "tolerance_pct": 0.01,
      "csharp_formula": "63.0 * 0.0075 * (44/28) * 100.0 = 74.25 kg N2O"
    },
    {
      "test_id": "NL002",
      "description": "Sunflower (Solsikke, code 24) on 100 ha",
      "inputs": {
        "typetal_kg_n_per_ha": 74.0,
        "area_ha": 100.0
      },
      "expected_outputs": {
        "n2o_kg": 87.214,
        "co2e_kg_gwp_ar4": 25989.86,
        "co2e_kg_gwp_ar6": 23809.42
      },
      "tolerance_pct": 0.01
    },
    {
      "test_id": "NL003",
      "description": "Spring barley + catch crops (negative leaching)",
      "inputs": {
        "crops": [
          {"typetal_kg_n_per_ha": 63.0, "area_ha": 100.0},
          {"typetal_kg_n_per_ha": -30.0, "area_ha": 100.0}
        ]
      },
      "expected_outputs": {
        "n2o_kg": 38.893,
        "co2e_kg_gwp_ar4": 11590.07,
        "co2e_kg_gwp_ar6": 10617.79
      },
      "tolerance_pct": 0.01
    }
  ],
  "crop_residue": [
    {
      "test_id": "CR001",
      "description": "Spring barley with straw incorporated",
      "inputs": {
        "crop_code": 1,
        "crop_standard_yield_kg_ts_ha": 4930.0,
        "slope": 0.98,
        "intercept": 590.0,
        "biomass_ratio_underground": 0.22,
        "n_above_ground": 0.007,
        "n_below_ground": 0.014,
        "is_crop_ploughed_in": true,
        "area_ha": 1.0,
        "ef_n2o": 0.01
      },
      "expected_outputs": {
        "above_ground_kg_ts_ha": 5421.4,
        "below_ground_kg_ts_ha": 2277.308,
        "n_above_kg_ha": 37.95,
        "n_below_kg_ha": 31.88,
        "n_total_kg_ha": 69.83,
        "n2o_kg": 1.098,
        "co2e_kg_gwp_ar4": 327.2,
        "co2e_kg_gwp_ar6": 299.75
      },
      "tolerance_pct": 1.0,
      "csharp_formula": "aboveGround = 4930 * 0.98 + 590 = 5421.4; belowGround = (4930 + 5421.4) * 0.22 = 2277.308"
    },
    {
      "test_id": "CR002",
      "description": "Spring barley WITHOUT straw incorporated",
      "inputs": {
        "crop_code": 1,
        "crop_standard_yield_kg_ts_ha": 4930.0,
        "slope": 0.98,
        "intercept": 590.0,
        "biomass_ratio_underground": 0.22,
        "n_above_ground": 0.007,
        "n_below_ground": 0.014,
        "is_crop_ploughed_in": false,
        "crop_yield_straw_fraction": 0.6,
        "area_ha": 1.0,
        "ef_n2o": 0.01
      },
      "expected_outputs": {
        "above_ground_kg_ts_ha": 5421.4,
        "below_ground_kg_ts_ha": 2277.308,
        "n_above_kg_ha": 17.26,
        "n_below_kg_ha": 31.88,
        "n_total_kg_ha": 49.14,
        "n2o_kg": 0.773,
        "co2e_kg_gwp_ar4": 230.35,
        "co2e_kg_gwp_ar6": 211.03
      },
      "tolerance_pct": 1.0,
      "note": "Straw removed: n_above = (5421.4 - 0.6*4930) * 0.007 = 17.26"
    }
  ],
  "cattle_digestion": [
    {
      "test_id": "CD001",
      "description": "Heavy breed dairy cow - 100 animals",
      "inputs": {
        "cattle_breed": "heavy",
        "year_animals": 100.0,
        "feed_intake_kg_ts_day": 24.0,
        "fatty_acids_g_kg_ts": 20.0,
        "ndf_g_kg_ts": 350.0
      },
      "expected_outputs": {
        "ch4_per_animal_kg": 194.65,
        "ch4_total_kg": 19465.0,
        "co2e_kg_gwp_ar4": 486625.0,
        "co2e_kg_gwp_ar6": 525555.0
      },
      "tolerance_pct": 1.0,
      "csharp_formula": "(1.230 * 24 - 0.145 * 20 + 0.012 * 350) / 55.65 * 335 + 0.304 * 30 = 161.42 kg CH4/animal"
    },
    {
      "test_id": "CD002",
      "description": "Jersey breed dairy cow - 50 animals",
      "inputs": {
        "cattle_breed": "jersey",
        "year_animals": 50.0,
        "feed_intake_kg_ts_day": 19.0,
        "fatty_acids_g_kg_ts": 28.0,
        "ndf_g_kg_ts": 330.0
      },
      "expected_outputs": {
        "ch4_per_animal_kg": 146.29,
        "ch4_total_kg": 7314.5,
        "co2e_kg_gwp_ar4": 182862.5,
        "co2e_kg_gwp_ar6": 197491.5
      },
      "tolerance_pct": 1.0,
      "csharp_formula": "(1.230 * 19 - 0.145 * 28 + 0.012 * 330) / 55.65 * 335 + 0.207 * 30 = 120.89 kg CH4/animal"
    }
  ],
  "liming": [
    {
      "test_id": "LM001",
      "description": "Standard liming on 100 ha",
      "inputs": {
        "total_ha": 100.0,
        "kg_lime_per_ha": 170.0
      },
      "expected_outputs": {
        "total_kg_lime": 17000.0,
        "co2_kg": 7474.17
      },
      "tolerance_pct": 0.1,
      "csharp_formula": "((17000 / 100.09) * 12.01) * (44 / 12) = 7474.17 kg CO2"
    },
    {
      "test_id": "LM002",
      "description": "Custom liming rate on 50 ha",
      "inputs": {
        "total_ha": 50.0,
        "kg_lime_per_ha": 250.0
      },
      "expected_outputs": {
        "total_kg_lime": 12500.0,
        "co2_kg": 5496.44
      },
      "tolerance_pct": 0.1
    }
  ],
  "carbon_balance": [
    {
      "test_id": "CB001",
      "description": "Spring barley - relative to Danish average",
      "inputs": {
        "crop_yield_kg_ts_ha": 4930.0,
        "above_ground_kg_ts_ha": 5421.4,
        "below_ground_kg_ts_ha": 2277.3,
        "is_crop_ploughed_in": true,
        "carbon_balance_adjust_type": "SubstractAvg",
        "avg_crop_kg_c": 4093.0,
        "area_ha": 1.0
      },
      "expected_outputs": {
        "total_residue_kg_ts": 7698.7,
        "total_residue_kg_c": 3464.4,
        "adjusted_kg_c": -628.6,
        "co2_kg": -230.8,
        "co2e_kg": 230.8
      },
      "tolerance_pct": 2.0,
      "csharp_formula": "C_residue = (5421.4 + 2277.3) * 0.45 = 3464.4; adjusted = 3464.4 - 4093.0 = -628.6; CO2 = -628.6 * (44/12) * 0.097 * -1 = 223.5",
      "note": "Negative CO2 means sequestration (emission reduction)"
    }
  ],
  "fertilizer_application": [
    {
      "test_id": "FA001",
      "description": "Mineral fertilizer without nitrification inhibitor",
      "inputs": {
        "kg_n": 122.0,
        "ef_n2o": 0.01,
        "ef_nh3": 0.05,
        "ef_nox": 0.04,
        "nitrification_inhibitor_kg_n": 0
      },
      "expected_outputs": {
        "n2o_soil_kg": 1.918,
        "n2o_nh3_kg": 0.096,
        "n2o_nox_kg": 0.022,
        "n2o_total_kg": 2.036,
        "co2e_kg_gwp_ar4": 606.8,
        "co2e_kg_gwp_ar6": 555.8
      },
      "tolerance_pct": 1.0
    }
  ]
}
