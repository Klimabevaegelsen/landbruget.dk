                "dateColumn": "event_date",
                "descriptionColumn": "description",
                "groupByColumns": [
                  "event_type"
                ],
                "filterColumns": [
                  "event_type"
                ]
              },
              "orderBy": [
                {
                  "column": "event_date",
                  "direction": "desc"
                }
              ]
            }
          }
