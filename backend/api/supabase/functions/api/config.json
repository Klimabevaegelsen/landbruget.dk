{
  "metadata": {
    "configVersion": "1.3"
  },
  "pageBuilder": [
    {
      "_key": "company-identity",
      "_type": "infoCard",
      "title": "Virksomhed identitet",
      "dataSource": {
        "params": {
          "source": "companies",
          "record": {
            "mappings": [
              {
                "label": "Navn",
                "column": "company_name"
              },
              {
                "label": "CVR",
                "column": "cvr_number"
              },
              {
                "label": "Adresse",
                "column": "address"
              },
              {
                "label": "Postnummer",
                "column": "postal_code"
              },
              {
                "label": "By",
                "column": "city"
              },
              {
                "label": "Reklamebeskyttelse",
                "column": "advertisement_protection",
                "format": "boolean"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "company-ownership",
      "_type": "dataGrid",
      "title": "Ejerforhold (oversigt)",
      "dataSource": {
        "params": {
          "source": "company_owners",
          "table": {
            "columns": [
              {
                "key": "owner",
                "label": "Ejer / Enhed",
                "column": "owner_name"
              },
              {
                "key": "share_bucket",
                "label": "Ejerandel (Bucket)",
                "column": "ownership_percentage"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "company-leadership",
      "_type": "dataGrid",
      "title": "Ledelse",
      "dataSource": {
        "params": {
          "source": "company_leadership",
          "table": {
            "columns": [
              {
                "key": "name",
                "label": "Navn",
                "column": "person_name"
              },
              {
                "key": "role",
                "label": "Stilling",
                "column": "role_title"
              },
              {
                "key": "since",
                "label": "Siden",
                "column": "start_date",
                "format": "date"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "company-map-overview",
      "_type": "mapChart",
      "title": "Kort: produktionssteder, marker, virksomhedens adresse",
      "dataSource": {
        "params": {
          "map": {
            "layers": [
              {
                "name": "Produktionssteder",
                "source": "production_sites",
                "geometryColumn": "location_geom",
                "properties": [
                  "site_name",
                  "chr",
                  "capacity"
                ],
                "style": "production_site_marker"
              },
              {
                "name": "Marker",
                "source": "field_boundaries",
                "geometryColumn": "geom",
                "properties": [
                  "field_identifier",
                  "area_ha"
                ],
                "style": "field"
              },
              {
                "name": "Virksomhedens adresse",
                "source": "companies",
                "geometryColumn": "address_geom",
                "properties": [
                  "address"
                ],
                "style": "hq_marker"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "financials-latest-kpis",
      "_type": "kpiGroup",
      "title": "Finansielle nøgletal (seneste år)",
      "dataSource": {
        "params": {
          "source": "yearly_financials",
          "kpis": {
            "timeContext": "last_n_years",
            "n": 1,
            "metrics": [
              {
                "key": "net_profit",
                "label": "Nettoresultat",
                "column": "net_profit_loss",
                "format": "currency"
              },
              {
                "key": "operating_profit",
                "label": "Driftsresultat",
                "column": "operating_profit_loss",
                "format": "currency"
              },
              {
                "key": "total_assets",
                "label": "Samlede Aktiver",
                "column": "total_assets",
                "format": "currency"
              },
              {
                "key": "equity_ratio",
                "label": "Soliditetsgrad",
                "column": "equity_ratio",
                "format": "percentage"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "financials-history",
      "_type": "barChart",
      "title": "Økonomisk udvikling (pr. år)",
      "dataSource": {
        "params": {
          "source": "yearly_financials",
          "timeSeries": {
            "timeColumn": "reporting_year",
            "metrics": [
              {
                "key": "net_profit",
                "column": "net_profit_loss",
                "seriesName": "Nettoresultat"
              },
              {
                "key": "operating_profit",
                "column": "operating_profit_loss",
                "seriesName": "Driftsresultat"
              },
              {
                "key": "total_assets",
                "column": "total_assets",
                "seriesName": "Samlede aktiver"
              }
            ]
          },
          "orderBy": [
            {
              "column": "reporting_year",
              "direction": "asc"
            }
          ]
        }
      }
    },
    {
      "_key": "financials-detailed-kpis",
      "_type": "kpiGroup",
      "title": "Detaljerede finansielle nøgletal",
      "dataSource": {
        "params": {
          "source": "yearly_financials",
          "kpis": {
            "timeContext": "last_n_years",
            "n": 1,
            "metrics": [
              {
                "key": "total_equity",
                "label": "Egenkapital",
                "column": "total_equity",
                "format": "currency"
              },
              {
                "key": "employee_costs",
                "label": "Lønomkostninger",
                "column": "employee_benefits_expense",
                "format": "currency"
              },
              {
                "key": "employees",
                "label": "Antal Medarbejdere",
                "column": "average_number_of_employees",
                "format": "number"
              },
              {
                "key": "cash",
                "label": "Likvide Midler",
                "column": "cash_and_cash_equivalents",
                "format": "currency"
              },
              {
                "key": "return_on_assets",
                "label": "Forrentning af Aktiver",
                "column": "return_on_assets",
                "format": "percentage"
              },
              {
                "key": "profit_per_employee",
                "label": "Resultat pr. Medarbejder",
                "column": "profit_per_employee",
                "format": "currency"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "subsidies-history-stacked",
      "_type": "stackedBarChart",
      "title": "Tilskud fordelt på type (pr. år)",
      "dataSource": {
        "params": {
          "source": "subsidy_details",
          "timeSeries": {
            "timeColumn": "year",
            "valueColumn": "amount_dkk",
            "groupByColumn": "subsidy_type"
          },
          "orderBy": [
            {
              "column": "year",
              "direction": "asc"
            }
          ]
        }
      }
    },
    {
      "_key": "land-use-kpis",
      "_type": "kpiGroup",
      "title": "Arealanvendelse nøgletal",
      "dataSource": {
        "params": {
          "source": "land_use_summary",
          "kpis": {
            "timeContext": "last_n_years",
            "n": 1,
            "metrics": [
              {
                "key": "total_ha",
                "label": "Antal Hektar (Total)",
                "column": "total_area_ha",
                "format": "number"
              },
              {
                "key": "organic_ha",
                "label": "Økologisk Hektar (Total)",
                "column": "organic_area_ha",
                "format": "number"
              },
              {
                "key": "rank_dk_ha",
                "label": "Rankering på landsplan (Ha)",
                "column": "rank_dk_total_area"
              },
              {
                "key": "rank_mun_ha",
                "label": "Rankering i kommunen (Ha)",
                "column": "rank_municipality_total_area"
              },
              {
                "key": "rank_dk_org",
                "label": "Rankering på landsplan (Ha Øko)",
                "column": "rank_dk_organic_total_area"
              },
              {
                "key": "rank_mun_org",
                "label": "Rankering i kommunen (Ha Øko)",
                "column": "rank_municipality_organic_total_area"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "land-use-crop-distribution",
      "_type": "horizontalStackedBarChart",
      "title": "Afgrødefordeling i hektar (seneste år, øko/konv)",
      "dataSource": {
        "params": {
          "source": "field_yearly_data",
          "category": {
            "timeContext": "last_n_years",
            "n": 1,
            "categoryColumn": "crop_name",
            "valueColumn": "area_ha",
            "stackByColumn": "is_organic",
            "topN": 9,
            "orderBy": [
              {
                "column": "area_ha",
                "direction": "desc"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "land-use-field-map",
      "_type": "mapChart",
      "title": "Markernes placering & status (seneste år)",
      "dataSource": {
        "params": {
          "map": {
            "layers": [
              {
                "name": "Marker",
                "source": "field_boundaries",
                "geometryColumn": "geom",
                "properties": [
                  "field_identifier",
                  "field_name",
                  "area_ha",
                  "crop_name",
                  "is_organic"
                ],
                "style": "field_detailed"
              }
            ]
          }
        }
      }
    },
    {
