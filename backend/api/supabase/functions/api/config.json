          "_key": "site-species-iteration-{iteratorContext.chr}",
          "_type": "iteratedSection",
          "title": "Detaljer pr. dyreart på site",
          "iteratorDataSource": {
            "params": {
              "source": "site_species_production_ranked",
              "filter": {
                "chr": "{iteratorContext.chr}"
              },
              "columns": [
                "species_id",
                "species_name"
              ]
