        "params": {
          "source": "incidents",
          "events": {
            "filter": {
              "type": "slurry_leak"
            },
            "dateColumn": "incident_date",
            "descriptionColumn": "description"
          },
          "orderBy": [
            {
              "column": "incident_date",
              "direction": "desc"
            }
          ]
        }
      }
    },
    {
      "_key": "environment-nitrogen-leaching",
      "_type": "comboChart",
      "title": "Kv\u00e6lstofudvaskning (Total og pr. Hektar)",
      "dataSource": {
        "params": {
          "source": "environment_summary",
          "timeSeries": {
            "timeColumn": "year",
            "metrics": [
              {
                "key": "total_n",
                "seriesName": "Total Kg N Udledt",
                "column": "total_n_leached_kg",
                "type": "bar",
                "yAxis": "left"
              },
              {
                "key": "n_per_ha",
                "seriesName": "Kg N Udledt pr. Ha",
                "column": "n_leached_kg_per_ha",
                "type": "line",
                "yAxis": "right"
              }
            ]
          },
          "orderBy": [
            {
              "column": "year",
              "direction": "asc"
            }
          ]
        }
      }
    },
    {
      "_key": "environment-nitrogen-per-field",
      "_type": "dataGrid",
      "title": "Kv\u00e6lstofudvaskning pr. Mark (Detaljeret)",
      "dataSource": {
        "params": {
          "source": "field_yearly_data",
          "table": {
            "columns": [
              {
                "key": "field_id",
                "label": "Mark ID",
                "column": "field_uuid"
              },
              {
                "key": "year",
                "label": "\u00c5r",
                "column": "year",
                "isFilterable": true,
                "isHidden": true
              },
              {
                "key": "n_leached_kg",
                "label": "Udledt N (kg)",
                "column": "n_leached_kg",
                "format": "number"
              }
            ],
            "initialFilter": {
              "year": "latest"
            }
          },
          "orderBy": [
            {
              "column": "year",
              "direction": "desc"
            },
            {
              "column": "field_uuid",
              "direction": "asc"
            }
          ]
        }
      },
      "allowFiltering": true
    },
    {
      "_key": "environment-pesticide-load",
      "_type": "comboChart",
      "title": "Pesticidbelastning (Total og pr. Hektar)",
      "dataSource": {
        "params": {
          "source": "environment_summary",
          "timeSeries": {
            "timeColumn": "year",
            "metrics": [
              {
                "key": "total_load",
