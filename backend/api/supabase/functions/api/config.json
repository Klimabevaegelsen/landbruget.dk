{
  "metadata": {
    "configVersion": "1.3"
  },
  "pageBuilder": [
    {
      "_key": "company-identity",
      "_type": "infoCard",
      "title": "Virksomhed Identitet",
      "dataSource": {
        "params": {
          "source": "companies",
          "record": {
            "mappings": [
              {
                "label": "Navn",
                "column": "company_name"
              },
              {
                "label": "CVR",
                "column": "cvr_number"
              },
              {
                "label": "Adresse",
                "column": "address"
              },
              {
                "label": "Postnummer",
                "column": "postal_code"
              },
              {
                "label": "By",
                "column": "city"
              },
              {
                "label": "Reklamebeskyttelse",
                "column": "advertisement_protection",
                "format": "boolean"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "company-ownership",
      "_type": "dataGrid",
      "title": "Ejerforhold (Oversigt)",
      "dataSource": {
        "params": {
          "source": "company_owners",
          "table": {
            "columns": [
              {
                "key": "owner",
                "label": "Ejer / Enhed",
                "column": "owner_name"
              },
              {
                "key": "share_bucket",
                "label": "Ejerandel (Bucket)",
                "column": "ownership_percentage"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "company-leadership",
      "_type": "dataGrid",
      "title": "Ledelse",
      "dataSource": {
        "params": {
          "source": "company_leadership",
          "table": {
            "columns": [
              {
                "key": "name",
                "label": "Navn",
                "column": "person_name"
              },
              {
                "key": "role",
                "label": "Stilling",
                "column": "role_title"
              },
              {
                "key": "since",
                "label": "Siden",
                "column": "start_date",
                "format": "date"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "company-map-overview",
      "_type": "mapChart",
      "title": "Kort: Bygninger, Marker, Virksomhedens adresse",
      "dataSource": {
        "params": {
          "map": {
            "layers": [
              {
                "name": "Bygninger",
                "source": "building_footprints",
                "geometryColumn": "geom",
                "properties": [
                  "building_name",
                  "type"
                ],
                "style": "building"
              },
              {
                "name": "Marker",
                "source": "field_boundaries",
                "geometryColumn": "geom",
                "properties": [
                  "field_identifier",
                  "area_ha"
                ],
                "style": "field"
              },
              {
                "name": "Virksomhedens adresse",
                "source": "companies",
                "geometryColumn": "address_geom",
                "properties": [
                  "address"
                ],
                "style": "hq_marker"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "financials-latest-kpis",
      "_type": "kpiGroup",
      "title": "Finansielle N\u00f8gletal (Seneste \u00c5r)",
      "dataSource": {
        "params": {
          "source": "yearly_financials",
          "kpis": {
            "timeContext": "last_n_years",
            "n": 1,
            "metrics": [
              {
                "key": "revenue",
                "label": "Oms\u00e6tning",
                "column": "revenue",
                "format": "currency"
              },
              {
                "key": "profit",
                "label": "Resultat",
                "column": "profit",
                "format": "currency"
              },
              {
                "key": "subsidies",
                "label": "Tilskud (Total)",
                "column": "total_subsidies",
                "format": "currency"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "financials-history",
      "_type": "barChart",
      "title": "\u00d8konomisk Udvikling (pr. \u00c5r)",
      "dataSource": {
        "params": {
          "source": "yearly_financials",
          "timeSeries": {
            "timeColumn": "year",
            "metrics": [
              {
                "key": "revenue",
                "column": "revenue",
                "seriesName": "Oms\u00e6tning"
              },
              {
                "key": "profit",
                "column": "profit",
                "seriesName": "Resultat"
              },
              {
                "key": "subsidies",
                "column": "total_subsidies",
                "seriesName": "Tilskud"
              }
            ]
          },
          "orderBy": [
            {
              "column": "year",
              "direction": "asc"
            }
          ]
        }
      }
    },
    {
      "_key": "subsidies-history-stacked",
      "_type": "stackedBarChart",
      "title": "Tilskud Fordelt p\u00e5 Type (pr. \u00c5r)",
      "dataSource": {
        "params": {
          "source": "subsidy_details",
          "timeSeries": {
            "timeColumn": "year",
            "valueColumn": "amount_dkk",
            "groupByColumn": "subsidy_type"
          },
          "orderBy": [
            {
              "column": "year",
              "direction": "asc"
            }
          ]
        }
      }
    },
    {
      "_key": "land-use-kpis",
      "_type": "kpiGroup",
      "title": "Arealanvendelse N\u00f8gletal",
      "dataSource": {
        "params": {
          "source": "land_use_summary",
          "kpis": {
            "timeContext": "last_n_years",
            "n": 1,
            "metrics": [
              {
                "key": "total_ha",
                "label": "Antal Hektar (Total)",
                "column": "total_area_ha",
                "format": "number"
              },
              {
                "key": "organic_ha",
                "label": "\u00d8kologisk Hektar (Total)",
                "column": "organic_area_ha",
                "format": "number"
              },
              {
                "key": "rank_dk_ha",
                "label": "Placering DK (Ha)",
                "column": "rank_dk_total_area"
              },
              {
                "key": "rank_mun_ha",
                "label": "Placering Kommune (Ha)",
                "column": "rank_municipality_total_area"
              },
              {
                "key": "rank_dk_org",
                "label": "Placering DK (Ha \u00d8ko)",
                "column": "rank_dk_organic_total_area"
              },
              {
                "key": "rank_mun_org",
                "label": "Placering Kommune (Ha \u00d8ko)",
                "column": "rank_municipality_organic_total_area"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "land-use-crop-distribution",
      "_type": "horizontalStackedBarChart",
      "title": "Afgr\u00f8defordeling (Seneste \u00c5r, \u00d8ko/Konv)",
      "dataSource": {
        "params": {
          "source": "field_yearly_data",
          "category": {
            "timeContext": "last_n_years",
            "n": 1,
            "categoryColumn": "crop_name",
            "valueColumn": "area_ha",
            "stackByColumn": "is_organic",
            "topN": 9,
            "orderBy": [
              {
                "column": "area_ha",
                "direction": "desc"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "land-use-field-map",
      "_type": "mapChart",
      "title": "Markernes Placering & Status (Seneste \u00c5r)",
      "dataSource": {
        "params": {
          "map": {
            "layers": [
              {
                "name": "Marker",
                "source": "field_boundaries",
                "geometryColumn": "geom",
                "properties": [
                  "field_identifier",
                  "field_name",
                  "area_ha",
                  "crop_name",
                  "is_organic"
                ],
                "style": "field_detailed"
              }
            ]
          }
        }
      }
    },
    {
      "_key": "land-use-bnbo-chart",
      "_type": "horizontalStackedBarChart",
      "title": "BNBO Status Fordeling (Snapshot)",
      "dataSource": {
        "params": {
          "source": "bnbo_summary",
          "category": {
            "timeContext": "last_n_years",
            "n": 1,
            "categoryColumn": "status",
            "valueColumn": "area_ha"
          }
        }
      }
    },
    {
      "_key": "land-use-bnbo-kpis",
      "_type": "kpiGroup",
      "title": "BNBO N\u00f8gletal & Placering",
      "dataSource": {
        "params": {
          "source": "bnbo_summary",
          "kpis": {
            "timeContext": "last_n_years",
            "n": 1,
            "filter": {
              "status": "not_dealt_with"
