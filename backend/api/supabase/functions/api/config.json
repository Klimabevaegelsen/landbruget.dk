                "yAxis": "left"
              },
              {
                "key": "load_per_ha",
                "seriesName": "Belastning pr. Ha",
                "column": "pesticide_load_index_per_ha",
                "type": "line",
                "yAxis": "right"
              }
            ]
          },
          "orderBy": [
            {
              "column": "year",
              "direction": "asc"
            }
          ]
        }
      }
    },
