              "dataSource": {
                "params": {
                  "source": "site_species_production_ranked",
                  "kpis": {
                    "filter": {
                      "chr": "{iteratorContext.chr}",
                      "species_id": "{iteratorContext.species_id}",
                      "year": "latest"
                    },
                    "metrics": [
                      {
                        "key": "production_animals",
                        "label": "Kapacitet (Antal dyr)",
                        "column": "total_animals"
                      },
                      {
                        "key": "rank_dk_species_prod",
                        "label": "Rankering på landsplan (Art Kapacitet)",
                        "column": "rank_dk_species_production"
                      },
                      {
                        "key": "rank_mun_species_prod",
                        "label": "Rankering i kommunen (Art Kapacitet)",
                        "column": "rank_municipality_species_production"
                      }
                    ]
                  }
                }
              }
            },
            {
              "_key": "species-age-chart-{iteratorContext.chr}-{iteratorContext.species_id}",
              "_type": "stackedBarChart",
              "title": "{iteratorContext.species_name} kapacitet pr. år (kategori)",
              "dataSource": {
                "params": {
                  "source": "animal_capacity_log",
                  "timeSeries": {
                    "filter": {
                      "chr": "{iteratorContext.chr}",
                      "species_id": "{iteratorContext.species_id}"
                    },
                    "timeColumn": "EXTRACT(YEAR FROM capacity_date)",
                    "valueColumn": "capacity_count",
                    "groupByColumn": "category"
                  },
                  "orderBy": [
                    {
                      "column": "EXTRACT(YEAR FROM capacity_date)",
                      "direction": "asc"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
