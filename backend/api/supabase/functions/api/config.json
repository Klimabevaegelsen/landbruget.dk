                "yAxis": "left"
              },
              {
                "key": "compliance_rate",
                "seriesName": "Overholdelsesgrad (%)",
                "column": "compliance_rate",
                "type": "line",
                "yAxis": "right"
              }
            ]
          },
          "orderBy": [
            {
              "column": "year",
              "direction": "asc"
