      "_key": "environment-nitrogen-per-field",
      "_type": "dataGrid",
      "title": "Kvælstofudvaskning pr. mark (detaljeret)",
      "dataSource": {
        "params": {
          "source": "field_yearly_data",
          "table": {
            "columns": [
              {
                "key": "field_id",
                "label": "Mark ID",
                "column": "field_uuid"
              },
              {
                "key": "year",
                "label": "År",
                "column": "year",
                "isFilterable": true,
                "isHidden": true
              },
              {
                "key": "n_leached_kg",
                "label": "Udledt N (kg)",
                "column": "n_leached_kg",
                "format": "number"
              }
            ],
            "initialFilter": {
              "year": "latest"
            }
          },
          "orderBy": [
            {
              "column": "year",
              "direction": "desc"
            },
            {
              "column": "field_uuid",
              "direction": "asc"
            }
          ]
        }
      },
      "allowFiltering": true
