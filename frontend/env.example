# Copy this to .env.local for local development

# Site password protection
NEXT_PUBLIC_SITE_PASSWORD=your_secure_password_here

# API Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_API_KEY=your_supabase_anon_key
NEXT_PUBLIC_DATA_URL=https://api.landbruget.dk/api/v1

# PMTiles / R2 endpoints
NEXT_PUBLIC_PMTILES_BASE_URL=https://api.landbruget.dk
PMTILES_BASE_URL=https://api.landbruget.dk
